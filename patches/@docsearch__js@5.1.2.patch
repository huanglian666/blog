diff --git a/dist/esm/docsearch.js b/dist/esm/docsearch.js
index c7133ddc314646a68ea48cb86dc616d7402dbe37..f994ce9b8bdeafaafefbf04c4f422a40abce7748 100644
--- a/dist/esm/docsearch.js
+++ b/dist/esm/docsearch.js
@@ -13361,6 +13361,31 @@ function useModalEnvironment({ getEnvironmentProps, containerRef, dropdownRef, f
 		modalRef,
 		theme
 	});
+	// [博客定制] 输入节点被 React 重挂载时恢复焦点与光标：
+	// 点击输入框会触发重渲染，DocSearch 会重建 .DocSearch-Input 节点导致焦点丢失、
+	// 光标跳到末尾，用户无法继续编辑。此处用 MutationObserver 检测重挂载，
+	// 在指针原本位于输入框内时自动 focus 新节点并恢复光标位置。
+	if (typeof MutationObserver !== "undefined" && typeof window !== "undefined") {
+		let lastCaret = null;
+		let pointerInInput = false;
+		document.addEventListener("pointerdown", (e) => {
+			pointerInInput = !!(e.target && e.target.closest && e.target.closest(".DocSearch-Input"));
+		}, true);
+		document.addEventListener("selectionchange", () => {
+			const el = document.activeElement;
+			if (el && el.classList && el.classList.contains("DocSearch-Input")) {
+				try { lastCaret = el.selectionStart; } catch (_) {}
+			}
+		}, true);
+		const refocusIfRemounted = () => {
+			const input = modalRef.current && modalRef.current.querySelector(".DocSearch-Input");
+			if (input && pointerInInput && document.activeElement !== input && lastCaret != null) {
+				input.focus();
+				try { input.setSelectionRange(lastCaret, lastCaret); } catch (_) {}
+			}
+		};
+		new MutationObserver(refocusIfRemounted).observe(modalRef.current, { childList: true, subtree: true });
+	}
 }
 function useModalRefs() {
 	return {
@@ -16750,6 +16775,7 @@ function DocSearchModal(_ref) {
 		id: "docsearch",
 		defaultActiveItemId: 0,
 		openOnFocus: true,
+		ignoreCompositionEvents: true,
 		initialState: {
 			query: initialQuery,
 			context: { searchSuggestions: [] }
